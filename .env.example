# Copy to .env and replace every placeholder before running `make up`.
POSTGRES_USER=chainlens
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=chainlens
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Neo4j 5-community (local Docker is the default; Aura Free can be swapped in).
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_neo4j
NEO4J_URI=bolt://localhost:7687
# Optional link shown only when Neo4j is reachable and the wallet is curated.
NEO4J_BROWSER_URL=http://localhost:7474/browser/

# Neo4j memory caps for a student laptop (override if needed).
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=1g
NEO4J_PAGECACHE=512m

# Phase 2 one-off export only. The runtime pipeline never calls BigQuery.
BIGQUERY_PROJECT=your-gcp-project-id
BQ_MAX_BYTES=1099511627776
INSTALL_BIGQUERY=0
