# ChainLens runtime secrets. Copy to .env and replace the placeholder.
# .env is gitignored; never commit the real key.
#
# Etherscan V2: every request needs a key. Free tier: 3 calls/sec, 100k/day.
# Create one at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key_here
ETHERSCAN_CHAIN_ID=1
ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api

# Optional: point the dashboard at a different artifact directory.
# CHAINLENS_OUTPUT_DIR=data/output
